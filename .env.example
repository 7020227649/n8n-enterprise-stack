# ─── Required ──────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here

# ─── n8n Authentication ───────────────────────────────
N8N_USER=admin
N8N_PASS=your_secure_password_here

# ─── n8n API Key (Recommended for n8n v1+) ───────────
# Generate in n8n: Settings > Developer > API Keys
N8N_API_KEY=

# ─── n8n Base URL (Internal Docker network) ──────────
# Only change if using a custom n8n hostname/port
# ─── n8n Base URL (Internal Docker network) ──────────
# Only change if using a custom n8n hostname/port
N8N_BASE_URL=http://n8n-main:5678

# ─── Public URL (For Webhooks/Forms) ─────────────────
# The public IP or domain where n8n is accessible
# Example: http://1.2.3.4:5678 or https://n8n.example.com
WEBHOOK_URL=

# ─── Database ─────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here

# ─── n8n Version (Docker image tag) ──────────────────
N8N_VERSION=latest

# ─── Security (Optional) ─────────────────────────────
# Webhook HMAC secret — secures the internal failure webhook
# If not set, IP-based filtering allows only internal Docker network
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
