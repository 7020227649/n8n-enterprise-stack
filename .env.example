# ─── Required ──────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here

# ─── n8n Authentication ───────────────────────────────
N8N_USER=admin
N8N_PASS=your_secure_password_here

# ─── Database ─────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here

# ─── n8n Version (Docker image tag) ──────────────────
N8N_VERSION=latest
